{
  "network": {
    "interface": null,
    "rfkill": false,
    "interval": null,
    "family": null,
    "format": "{icon}",
    "format-ethernet": "{icon}",
    "format-wifi": "{icon} <small>{essid}</small>",
    "format-linked": "{icon}",
    "format-disconnected": "{icon}",
    "format-disabled": "{icon}",
    "format-alt": null,
    "format-icons": {
      "wifi": [
        "󰤟",
        "󰤢",
        "󰤥",
        "󰤨"
      ],
      "ethernet": "󰈀",
      "linked": "",
      "disconnected": "󰤮",
      "disabled": "󰀝"
    },
    "rotate": 0,
    "align": 0,
    "justify": "center",
    "max-length": 15,
    "expand": false,
    "on-click-right": "footclient -a wifitui -T 'wifitui: WiFi Manager' wifitui",
    "smooth-scrolling-threshold": null,
    "tooltip": true,
    "tooltip-format": "{essid}  󰒢 {signalStrength}%   {frequency}GHz  󰩟 {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  󰒢 {signalStrength}%   {frequency}GHz  󰩟 {ipaddr}",
    "tooltip-format-wifi": "{essid}  󰒢 : {signalStrength}%, {frequency}GHz\nIPv4: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "tooltip-format-disabled": "Disabled"
  },
  "bluetooth": {
    "format-device-preference": [
      "Headphones",
      "Keyboard",
      "Mouse"
    ],
    "format": " {status}",
    "format-disabled": null,
    "format-off": "󰂲 Off",
    "format-on": "󰂯 On",
    "format-connected": "{icon} {num_connections}",
    "format-connected-battery": null,
    "format-icons": {
      "enabled": "󰂯",
      "connected": "󰂱",
      "on": "󰂯",
      "off": "󰂲",
      "disabled": "󰂲"
    },
    "on-double-click": "bluetoothctl power on",
    "on-click-middle": "bluetoothctl power off",
    "on-click-right": "footclient -a bluetui bluetui",
    "tooltip": true,
    "tooltip-format": "{controller_alias}\n{controller_address}\n\nStatus: {status}\n",
    "tooltip-format-disabled": "Bluetooth Disabled\n",
    "tooltip-format-off": "Bluetooth Powered Off\n",
    "tooltip-format-on": "{controller_alias}\n{controller_address}\n\nNo devices connected\n",
    "tooltip-format-connected": "{controller_alias}\n{controller_address}\n\nConnected Devices ({num_connections}):\n\n{device_enumerate}\n",
    "tooltip-format-connected-battery": "{controller_alias}\n{controller_address}\n\nDevice: {device_alias}\nBattery: {device_battery_percentage}%\n",
    "tooltip-format-no-controller": "No Bluetooth Controller Found\n",
    "tooltip-format-enumerate-connected": "• {device_alias}\n  Address: {device_address}\n",
    "tooltip-format-enumerate-connected-battery": "• {device_alias}\n  Address: {device_address}\n  Battery: {device_battery_percentage}%\n"
  }
}
